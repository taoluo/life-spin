{
  "name": "lifeloop",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "vendor:check": "node scripts/vendor-check.mjs",
    "vendor:sync": "node scripts/vendor-sync.mjs",
    "build": "node scripts/build-extension.mjs",
    "typecheck": "node scripts/write-tsconfig.mjs && tsc --noEmit",
    "schema:check": "node scripts/pin-schema.mjs",
    "test:integration": "node scripts/build-extension.mjs && node scripts/build-tests.mjs && node packages/vscode/out/runTest.js",
    "verify": "npm run typecheck && npm run vendor:check && npm run schema:check && npm test",
    "package": "node scripts/install-extension.mjs --no-install",
    "install-extension": "node scripts/install-extension.mjs",
    "test:foam": "node scripts/build-extension.mjs && node scripts/build-tests.mjs && node packages/vscode/out/runTest.js --foam"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
