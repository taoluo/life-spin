{
  "name": "lifeloop-vscode",
  "displayName": "LifeLoop",
  "description": "Task workflows for Markdown: Today, Review and Apple interoperability. Pair with Foam for notes.",
  "version": "0.1.0",
  "publisher": "lifeloop",
  "private": false,
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/*.md"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lifeloop-result",
        "aliases": [
          "LifeLoop Result"
        ],
        "extensions": [
          ".lifeloop-result"
        ]
      }
    ],
    "commands": [
      {
        "command": "lifeloop.capture",
        "title": "LifeLoop: Capture",
        "icon": "$(add)"
      },
      {
        "command": "lifeloop.captureHere",
        "title": "LifeLoop: Capture Here"
      },
      {
        "command": "lifeloop.captureSelection",
        "title": "LifeLoop: Capture Selection with Source"
      },
      {
        "command": "lifeloop.recoverLastCapture",
        "title": "LifeLoop: Recover Last Failed Capture"
      },
      {
        "command": "lifeloop.openInbox",
        "title": "LifeLoop: Open Inbox"
      },
      {
        "command": "lifeloop.processInbox",
        "title": "LifeLoop: Process Inbox",
        "icon": "$(ellipsis)"
      },
      {
        "command": "lifeloop.openToday",
        "title": "LifeLoop: Today",
        "icon": "$(calendar)"
      },
      {
        "command": "lifeloop.planToday",
        "title": "LifeLoop: Plan Today"
      },
      {
        "command": "lifeloop.closeTodayPlanTomorrow",
        "title": "LifeLoop: Close Today and Plan Tomorrow"
      },
      {
        "command": "lifeloop.openReview",
        "title": "LifeLoop: Weekly Review"
      },
      {
        "command": "lifeloop.reviewActions",
        "title": "LifeLoop: Review in Place"
      },
      {
        "command": "lifeloop.openNextWeekFocus",
        "title": "LifeLoop: Open Next Week Focus"
      },
      {
        "command": "lifeloop.reviewPeriodFacts",
        "title": "LifeLoop: Review Period Facts"
      },
      {
        "command": "lifeloop.freezeReview",
        "title": "LifeLoop: Freeze Review"
      },
      {
        "command": "lifeloop.openSbRef",
        "title": "LifeLoop: Open SB Reference at Cursor"
      },
      {
        "command": "lifeloop.reindex",
        "title": "LifeLoop: Rebuild Index"
      },
      {
        "command": "lifeloop.toggleWaiting",
        "title": "LifeLoop: Toggle Waiting"
      },
      {
        "command": "lifeloop.toggleSomeday",
        "title": "LifeLoop: Toggle Someday"
      },
      {
        "command": "lifeloop.setDeadline",
        "title": "LifeLoop: Set Deadline"
      },
      {
        "command": "lifeloop.setScheduled",
        "title": "LifeLoop: Set Scheduled"
      },
      {
        "command": "lifeloop.quickReschedule",
        "title": "LifeLoop: Quick Reschedule"
      },
      {
        "command": "lifeloop.attachPage",
        "title": "LifeLoop: Attach Page to Task"
      },
      {
        "command": "lifeloop.addRelatedLink",
        "title": "LifeLoop: Add Related Link"
      },
      {
        "command": "lifeloop.addNextAction",
        "title": "LifeLoop: Add Next Action"
      },
      {
        "command": "lifeloop.setProjectStatus",
        "title": "LifeLoop: Set Project Status"
      },
      {
        "command": "lifeloop.projectActions",
        "title": "LifeLoop: Project Actions",
        "icon": "$(ellipsis)"
      },
      {
        "command": "lifeloop.projectResumptionBrief",
        "title": "LifeLoop: Project Resumption Brief"
      },
      {
        "command": "lifeloop.meetingWrapUp",
        "title": "LifeLoop: Meeting Wrap-up"
      },
      {
        "command": "lifeloop.completeTask",
        "title": "Complete",
        "icon": "$(check)"
      },
      {
        "command": "lifeloop.reopenTask",
        "title": "Reopen"
      },
      {
        "command": "lifeloop.taskActions",
        "title": "LifeLoop: Task Actions",
        "icon": "$(ellipsis)"
      },
      {
        "command": "lifeloop.findTask",
        "title": "LifeLoop: Find Task"
      },
      {
        "command": "lifeloop.addFromBacklog",
        "title": "LifeLoop: Add from Backlog"
      },
      {
        "command": "lifeloop.waitingNextAction",
        "title": "LifeLoop: Waiting to Next Action"
      },
      {
        "command": "lifeloop.makeActionable",
        "title": "LifeLoop: Make Actionable"
      },
      {
        "command": "lifeloop.returnToLastFind",
        "title": "LifeLoop: Return to Last Find"
      },
      {
        "command": "lifeloop.explainTask",
        "title": "LifeLoop: Explain Task"
      },
      {
        "command": "lifeloop.addTaskNote",
        "title": "LifeLoop: Add Progress / Resume Cue"
      },
      {
        "command": "lifeloop.setNow",
        "title": "LifeLoop: Set Task as Now"
      },
      {
        "command": "lifeloop.returnToNow",
        "title": "LifeLoop: Return to Now"
      },
      {
        "command": "lifeloop.clearNow",
        "title": "LifeLoop: Clear Now"
      },
      {
        "command": "lifeloop.peekSource",
        "title": "LifeLoop: Peek Source"
      },
      {
        "command": "lifeloop.revealTask",
        "title": "Go to source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "lifeloop.refreshViews",
        "title": "LifeLoop: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "lifeloop.addReminder",
        "title": "LifeLoop: Add Reminder"
      },
      {
        "command": "lifeloop.addToCalendar",
        "title": "LifeLoop: Add to Calendar"
      },
      {
        "command": "lifeloop.syncProjected",
        "title": "LifeLoop: Sync Reminders and Calendar"
      },
      {
        "command": "lifeloop.syncExternal",
        "title": "LifeLoop: Sync External"
      },
      {
        "command": "lifeloop.importNotes",
        "title": "LifeLoop: Sync Apple Notes"
      },
      {
        "command": "lifeloop.resolveSyncConflict",
        "title": "LifeLoop: Resolve External Sync Conflict"
      },
      {
        "command": "lifeloop.showSyncReport",
        "title": "LifeLoop: Show External Sync Report"
      },
      {
        "command": "lifeloop.openExternalBinding",
        "title": "LifeLoop: Open External App"
      },
      {
        "command": "lifeloop.openQueryResult",
        "title": "LifeLoop: Open Query Result"
      },
      {
        "command": "lifeloop.reportUnsupported",
        "title": "LifeLoop: Report Unsupported Blocks"
      },
      {
        "command": "lifeloop.evalLua",
        "title": "LifeLoop: Evaluate Space Lua"
      },
      {
        "command": "lifeloop.runDeclaredCommand",
        "title": "LifeLoop: Run Declared Command"
      },
      {
        "command": "lifeloop.runSpaceLua",
        "title": "LifeLoop: Run Space Lua Blocks"
      },
      {
        "command": "lifeloop.cycleTaskState",
        "title": "LifeLoop: Cycle Task State"
      },
      {
        "command": "lifeloop.applyActionButtons",
        "title": "LifeLoop: Add Declared Action Buttons"
      },
      {
        "command": "lifeloop.moveUp",
        "title": "LifeLoop: Move Item Up"
      },
      {
        "command": "lifeloop.moveDown",
        "title": "LifeLoop: Move Item Down"
      },
      {
        "command": "lifeloop.moveIndent",
        "title": "LifeLoop: Indent Item"
      },
      {
        "command": "lifeloop.moveOutdent",
        "title": "LifeLoop: Outdent Item"
      },
      {
        "command": "lifeloop.bakeSection",
        "title": "LifeLoop: Bake Section at Cursor"
      },
      {
        "command": "lifeloop.unbakeSection",
        "title": "LifeLoop: Unbake Section at Cursor"
      },
      {
        "command": "lifeloop.updateBakedSections",
        "title": "LifeLoop: Update Baked Sections"
      },
      {
        "command": "lifeloop.showMentions",
        "title": "LifeLoop: Show Mentions"
      },
      {
        "command": "lifeloop.sign",
        "title": "LifeLoop: Sign This Block"
      },
      {
        "command": "lifeloop.toggleXray",
        "title": "LifeLoop: Toggle X-Ray"
      },
      {
        "command": "lifeloop.detachBinding",
        "title": "LifeLoop: Detach External Binding"
      },
      {
        "command": "lifeloop.copyBindingId",
        "title": "LifeLoop: Copy External Binding ID"
      },
      {
        "command": "lifeloop.logInteraction",
        "title": "LifeLoop: Log Interaction"
      },
      {
        "command": "lifeloop.createReconnectTask",
        "title": "LifeLoop: Create Reconnect Task"
      }
    ],
    "views": {
      "lifeloop": [
        {
          "id": "lifeloop.today",
          "name": "Today"
        },
        {
          "id": "lifeloop.projects",
          "name": "Projects"
        },
        {
          "id": "lifeloop.inbox",
          "name": "Inbox"
        },
        {
          "id": "lifeloop.linkedTasks",
          "name": "Linked Tasks"
        },
        {
          "id": "lifeloop.personContext",
          "name": "Person Context"
        },
        {
          "id": "lifeloop.mentions",
          "name": "Mentions"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lifeloop",
          "title": "LifeLoop",
          "icon": "resources/loop.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "lifeloop.capture",
          "when": "view == lifeloop.inbox",
          "group": "navigation"
        },
        {
          "command": "lifeloop.refreshViews",
          "when": "view =~ /^lifeloop\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "lifeloop.projectActions",
          "when": "viewItem == lifeloopProjectGap",
          "group": "inline"
        },
        {
          "command": "lifeloop.projectActions",
          "when": "viewItem == lifeloopProject",
          "group": "lifeloop"
        },
        {
          "command": "lifeloop.taskActions",
          "when": "viewItem == lifeloopTask",
          "group": "inline"
        },
        {
          "command": "lifeloop.processInbox",
          "when": "viewItem == lifeloopInboxItem",
          "group": "inline"
        },
        {
          "command": "lifeloop.logInteraction",
          "when": "viewItem == lifeloopPerson",
          "group": "inline"
        },
        {
          "command": "lifeloop.createReconnectTask",
          "when": "viewItem == lifeloopPerson",
          "group": "lifeloop"
        },
        {
          "command": "lifeloop.logInteraction",
          "when": "viewItem == lifeloopPerson",
          "group": "inline@1"
        },
        {
          "command": "lifeloop.createReconnectTask",
          "when": "viewItem == lifeloopPerson",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        { "command": "lifeloop.syncProjected", "when": "false" },
        { "command": "lifeloop.importNotes", "when": "false" },
        { "command": "lifeloop.completeTask", "when": "false" },
        { "command": "lifeloop.reopenTask", "when": "false" },
        { "command": "lifeloop.revealTask", "when": "false" },
        { "command": "lifeloop.explainTask", "when": "false" },
        { "command": "lifeloop.addTaskNote", "when": "false" },
        { "command": "lifeloop.peekSource", "when": "false" },
        { "command": "lifeloop.toggleWaiting", "when": "false" },
        { "command": "lifeloop.toggleSomeday", "when": "false" },
        { "command": "lifeloop.setScheduled", "when": "false" },
        { "command": "lifeloop.addReminder", "when": "false" },
        { "command": "lifeloop.detachBinding", "when": "false" },
        { "command": "lifeloop.copyBindingId", "when": "false" },
        { "command": "lifeloop.openExternalBinding", "when": "false" }
      ]
    },
    "configuration": {
      "title": "LifeLoop",
      "properties": {
        "lifeloop.inboxPage": {
          "type": "string",
          "default": "Inbox",
          "description": "Page captures land on."
        },
        "lifeloop.reviewFolder": {
          "type": "string",
          "default": "Reviews",
          "description": "Folder for weekly reviews."
        },
        "lifeloop.upcomingDays": {
          "type": "number",
          "default": 14,
          "description": "Days shown by Upcoming."
        },
        "lifeloop.staleDays": {
          "type": "number",
          "default": 21,
          "description": "Days before a project page counts as unchanged."
        },
        "lifeloop.reminderList": {
          "type": "string",
          "default": "",
          "description": "Reminders list new reminders go to. Empty means the default list."
        },
        "lifeloop.calendarName": {
          "type": "string",
          "default": "Calendar",
          "description": "Calendar new events go to, and the only one bindings are looked up in."
        },
        "lifeloop.eventMinutes": {
          "type": "number",
          "default": 60,
          "description": "Default length of an event created from a task."
        },
        "lifeloop.notesFolder": {
          "type": "string",
          "default": "LifeLoop Inbox",
          "description": "Apple Notes folder imported into the Inbox. Never the whole library."
        },
        "lifeloop.autoSync": {
          "type": "boolean",
          "default": false,
          "description": "Sync Reminders and Calendar on a timer. Off by default: installing the extension never changes external apps."
        },
        "lifeloop.syncMinutes": {
          "type": "number",
          "default": 5,
          "description": "Minutes between background sync passes."
        },
        "lifeloop.queryCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a result count above each query block. The hover and the Markdown preview work either way."
        },
        "lifeloop.executeSpaceLua": {
          "type": "boolean",
          "default": false,
          "description": "Run Space Lua blocks from your notes. Off by default: a vault can be shared, synced or cloned, and none of that means you meant to run the code inside it. Scripts are read-only and time-limited."
        },
        "lifeloop.spaceLuaBudgetMs": {
          "type": "number",
          "default": 2000,
          "description": "How long one Space Lua script may run before it is stopped."
        },
        "lifeloop.taskStates": {
          "type": "array",
          "default": [],
          "description": "Custom task states to cycle through, e.g. [{\"state\":\" \"},{\"state\":\"w\"},{\"state\":\"x\",\"done\":true}]. A done state is always added if you leave it out. Note that a marker other than [ ] or [x] is not a checkbox to other Markdown tools.",
          "items": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\[\\]\\r\\n]+$"
              },
              "done": {
                "type": "boolean"
              }
            }
          }
        },
        "lifeloop.identity": {
          "type": "string",
          "default": "",
          "description": "Your @name. Used for the Mention Inbox and for signing a block. Left empty, LifeLoop shows no mentions rather than guessing whose they are."
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./resources/preview.css"
    ],
    "keybindings": [
      {
        "command": "lifeloop.cycleTaskState",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "lifeloop.updateBakedSections",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "build": "node ../../scripts/build-extension.mjs",
    "watch": "node ../../scripts/build-extension.mjs --watch",
    "vscode:prepublish": "node ../../scripts/build-extension.mjs",
    "package": "vsce package --no-dependencies --out ../../dist/",
    "install-local": "node ../../scripts/install-extension.mjs"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  },
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tao/silverbullet-lifeloop.git"
  },
  "keywords": [
    "markdown",
    "notes",
    "tasks",
    "pkm",
    "gtd",
    "para",
    "zettelkasten"
  ],
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  }
}
