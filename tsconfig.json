{
  "$comment": "GENERATED by scripts/write-tsconfig.mjs from scripts/vendor-alias.mjs — do not edit paths by hand.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vscode"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2024"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@silverbulletmd/silverbullet/lib/*": [
        "vendor/silverbullet/plug-api/lib/*.ts"
      ],
      "@silverbulletmd/silverbullet/type/*": [
        "vendor/silverbullet/plug-api/types/*.ts"
      ],
      "@silverbulletmd/silverbullet/syscalls": [
        "vendor/silverbullet/plug-api/syscalls.ts"
      ],
      "@silverbulletmd/silverbullet/syscall": [
        "vendor/silverbullet/plug-api/syscall.ts"
      ],
      "@silverbulletmd/silverbullet/constants": [
        "vendor/silverbullet/plug-api/constants.ts"
      ],
      "@silverbulletmd/silverbullet/ui": [
        "vendor/silverbullet/plug-api/ui/index.ts"
      ],
      "@lifeloop/semantic-core": [
        "packages/semantic-core/src/index.ts"
      ],
      "@lifeloop/apple-bridge": [
        "packages/apple-bridge/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.d.ts",
    "test/conformance/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "silverbullet",
    "vendor"
  ]
}
